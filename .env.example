ENVIRONMENT=development
SECURE_COOKIES=False

SECRET_KEY=change-me
SESSION_SECRET=change-me
# Shared secret for automation calls to /api/v1/admin/connectors/* (X-Scheduler-Secret header).
# Leave empty to disable secret-based access. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SCHEDULER_SECRET=

# Comma-separated emails of accounts that may post/unlist jobs and trigger crawls.
ADMIN_EMAILS=

# Comma-separated list of origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Defaults to SQLite. For Postgres use postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./jobpulse.db

ENABLE_SCHEDULER=True
CONNECTOR_MAX_CONCURRENCY=5
DISCOVERY_INTERVAL_SECONDS=60
DISCOVERY_LOCK_TIMEOUT_SECONDS=900
JOB_MISSING_CYCLES_THRESHOLD=2

TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Needed for password-reset emails. Without SMTP, reset codes are only printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=JobPulse

OTP_EXPIRY_MINUTES=10
VERIFICATION_TOKEN_EXPIRY_HOURS=24
